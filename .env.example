# Google Drive media gallery ------------------------------------------------
# Copy this file to `.env.local` and fill in the values. Nothing here is
# committed — production values live in your hosting provider's env settings.
# /gallery lists the photos folder, /gallery/videos lists the videos folder.

# Folder ID from the Drive folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=

# Folder ID of the album that holds videos (same URL format as above).
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=

# Service-account email created in Google Cloud (usually
# <name>@<project>.iam.gserviceaccount.com). Share BOTH folders with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" from the service-account JSON key. Keep the \n escapes and
# wrap the whole value in double quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lead capture + admin panel ------------------------------------------------
# Supabase project the `public.leads` table lives in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key for the same project (server only; never expose to the
# browser). Already present in your local `.env`.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in at /admin/login. Generate a strong password with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_EMAIL=admin@vbcaterers.com
ADMIN_PASSWORD=

# HMAC secret for the signed 7-day admin session cookie — 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out immediately.
ADMIN_SESSION_SECRET=
